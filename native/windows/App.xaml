<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ApexBooks_Windows.App" RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ApexBooks_Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#1C3C72</Color>
            <Color x:Key="SystemAccentColorDark1">#152C53</Color>
            <Color x:Key="SystemAccentColorLight1">#264882</Color>
            <Color x:Key="SystemAccentColorLight2">#7292C9</Color>
            <Color x:Key="SystemAccentColorLight3">#A9BDDF</Color>
            <Color x:Key="SystemAccentColorDark2">#12274A</Color>
            <Color x:Key="SystemAccentColorDark3">#0D1C36</Color>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/DMSans.ttf#DM Sans</FontFamily>
            <Style TargetType="TextBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DFE3EB" />
                <Setter Property="Background" Value="#F9FBFC" />
                <Setter Property="Foreground" Value="#192F3B" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DFE3EB" />
                <Setter Property="Background" Value="#F9FBFC" />
                <Setter Property="Foreground" Value="#192F3B" />
            </Style>
            <Style TargetType="CalendarDatePicker">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DFE3EB" />
                <Setter Property="Background" Value="#F9FBFC" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
