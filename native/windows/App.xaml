<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ApexBooks_Windows.App" RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ApexBooks_Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#007A3D</Color>
            <Color x:Key="SystemAccentColorDark1">#006B35</Color>
            <Color x:Key="SystemAccentColorLight1">#159A53</Color>
            <Color x:Key="SystemAccentColorLight2">#6DC78F</Color>
            <Color x:Key="SystemAccentColorLight3">#DDF1E5</Color>
            <Color x:Key="SystemAccentColorDark2">#005B2D</Color>
            <Color x:Key="SystemAccentColorDark3">#003E20</Color>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/DMSans.ttf#DM Sans</FontFamily>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DCE3EB" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#202C3C" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#BFC9D5" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#202C3C" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DCE3EB" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#202C3C" />
            </Style>
            <Style TargetType="CalendarDatePicker">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DCE3EB" />
                <Setter Property="Background" Value="#FFFFFF" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
