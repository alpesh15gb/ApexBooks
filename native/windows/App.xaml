<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ApexBooks_Windows.App" RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ApexBooks_Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#B65324</Color>
            <Color x:Key="SystemAccentColorDark1">#97431B</Color>
            <Color x:Key="SystemAccentColorLight1">#C9713E</Color>
            <Color x:Key="SystemAccentColorLight2">#E6A470</Color>
            <Color x:Key="SystemAccentColorLight3">#F6D7BB</Color>
            <Color x:Key="SystemAccentColorDark2">#773F24</Color>
            <Color x:Key="SystemAccentColorDark3">#4A3023</Color>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/DMSans.ttf#DM Sans</FontFamily>
            <Style TargetType="TextBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#f0e5db" />
                <Setter Property="Background" Value="#fffcf9" />
                <Setter Property="Foreground" Value="#352d28" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#DCCABE" />
                <Setter Property="Background" Value="#FFFCF9" />
                <Setter Property="Foreground" Value="#352D28" />
                <Setter Property="Padding" Value="12,10" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#f0e5db" />
                <Setter Property="Background" Value="#fffcf9" />
                <Setter Property="Foreground" Value="#352d28" />
            </Style>
            <Style TargetType="CalendarDatePicker">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#f0e5db" />
                <Setter Property="Background" Value="#fffcf9" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
