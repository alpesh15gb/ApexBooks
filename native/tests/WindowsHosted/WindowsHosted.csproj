<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup><Reference Include="ApexBooks.Windows"><HintPath>$(ApexWindowsPublishDirectory)/ApexBooks.Windows.dll</HintPath></Reference></ItemGroup>
  <Target Name="CheckPublishedClient" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ApexWindowsPublishDirectory)/ApexBooks.Windows.dll')" Text="Pass ApexWindowsPublishDirectory pointing to a built Windows release." />
  </Target>
</Project>
