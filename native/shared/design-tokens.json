{
  "name": "Apex Books workspace",
  "version": 5,
  "note": "QuickBooks-inspired task navigation: dark desktop sidebar, green primary actions, neutral white cards. Mirrored in web and native themes.",
  "color": {
    "navy-950": "#172131",
    "navy-900": "#202C3C",
    "navy-800": "#253752",
    "navy-700": "#007A3D",
    "navy-600": "#007A3D",
    "navy-500": "#159A53",
    "navy-200": "#B5DCC5",
    "navy-100": "#E0F2E7",
    "navy-50": "#F0F8F3",
    "background": "#F4F5F7",
    "surface": "#FFFFFF",
    "line": "#E1E6ED",
    "line-strong": "#BFC9D5",
    "ink": "#202C3C",
    "ink-2": "#34445A",
    "muted": "#58677A",
    "brass": "#007A3D",
    "success": "#24745A",
    "success-bg": "#EAF4EE",
    "warning": "#98631C",
    "warning-bg": "#FBF2E2",
    "danger": "#B3261E",
    "danger-bg": "#FBECEB",
    "info": "#315F9B",
    "info-bg": "#EDF3FC",
    "sidebar": "#282B30",
    "sidebar-active": "#393D42"
  },
  "radius": {
    "small": 6,
    "medium": 8,
    "large": 12
  },
  "typography": {
    "web": "DM Sans (bundled)",
    "native": "DM Sans (bundled)",
    "numerals": "tabular",
    "supporting-size": 12,
    "body-size": 14
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    48
  ],
  "interaction": {
    "web-minimum-target": 44,
    "windows-minimum-target": 44,
    "android-minimum-target": 48,
    "focus": "visible",
    "reduced-motion": "respect-system"
  },
  "status": {
    "posted": "success",
    "settled": "success",
    "draft": "warning",
    "unpaid": "warning",
    "part-settled": "info",
    "converted": "info",
    "cancelled": "danger"
  }
