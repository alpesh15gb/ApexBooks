  "reports": [
    {
      "key": "summary",
      "title": "Transaction summary",
      "path": "/reports/summary",
      "group": "Business overview",
      "description": "A dated overview of sales, purchases, receipts and payments."
    },
    {
      "key": "sales",
      "title": "Sales register",
      "path": "/reports/register?group=sales",
      "group": "Sales and purchases",
      "description": "Review posted invoices, POS sales and customer returns."
    },
    {
      "key": "purchases",
      "title": "Purchase register",
      "path": "/reports/register?group=purchases",
      "group": "Sales and purchases",
      "description": "Review supplier bills and purchase returns."
    },
    {
      "key": "expenses",
      "title": "Expense register",
      "path": "/reports/register?group=expenses",
      "group": "Sales and purchases",
      "description": "Track operating expenses by supplier and category."
    },
    {
      "key": "financial",
      "title": "Profit and balance sheet",
      "path": "/reports/financial",
      "group": "Business overview",
      "description": "Profit, account balances and a balanced trial balance."
    },
    {
      "key": "gst",
      "title": "GST analysis",
      "path": "/reports/gst",
      "group": "GST and tax",
      "description": "Output GST, entered supplier tax and estimated set-off."
    },
    {
      "key": "gstr1",
      "title": "GSTR-1 working paper",
      "path": "/gst-returns/gstr1",
      "group": "GST and tax",
      "description": "GSTN section worksheets, preparation checks and draft JSON."
    },
    {
      "key": "gstr2a",
      "title": "GSTR-2A-style purchase register",
      "path": "/gst-returns/gstr2a",
      "group": "GST and tax",
      "description": "Purchase-book reconciliation, supplier bills and buyer returns."
    },
    {
      "key": "gstr3b",
      "title": "GSTR-3B working paper",
      "path": "/gst-returns/gstr3b",
      "group": "GST and tax",
      "description": "Numbered 3B schedules with a separate estimated set-off."
    },
    {
      "key": "parties",
      "title": "Party statement",
      "path": "/reports/parties",
      "group": "Parties and balances",
      "description": "Dated activity and running balances by party."
    },
    {
      "key": "ageing",
      "title": "Receivables and payables",
      "path": "/reports/ageing",
      "group": "Parties and balances",
      "description": "Receivable and payable ageing as of a chosen date."
    },
    {
      "key": "items",
      "title": "Item activity",
      "path": "/reports/items",
      "group": "Items and stock",
