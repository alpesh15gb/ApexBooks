    {
      "key": "credits",
      "title": "Credit balances",
      "path": "/reports/credits",
      "group": "Parties and balances",
      "description": "Available customer and supplier note credits."
    },
    {
      "key": "advances",
      "title": "Advance balances",
      "path": "/reports/advances",
      "group": "Parties and balances",
      "description": "Unallocated receipts and supplier advances."
