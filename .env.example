POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
# Generate once and keep private: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4o-mini
# Optional OpenAI-compatible provider. Keys stay on the API server.
OCR_BASE_URL=https://api.openai.com/v1
OCR_MODEL=gpt-4o-mini
OMNIROUTE_API_KEY=
# Default 0 requires HTTPS outside literal loopback. Only set 1 when deliberately
# accepting that HTTP exposes provider credentials and invoice bytes in transit.
OCR_ALLOW_INSECURE_HTTP=0
# Independent Fernet key for server-side commerce credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
COMMERCE_ENCRYPTION_KEY=
COMMERCE_ALLOWED_HOSTS=
CRON_SECRET=

# Docker Compose build provenance: full tested source commit SHA, never a secret.
# Leave unset when the build revision is unknown; no runtime git lookup occurs.
APEX_SOURCE_SHA=
APEX_RELEASE_VERSION=
# Direct API/native and direct Vite builds use these instead of Compose variables.
APEX_BUILD_SHA=
VITE_BUILD_SHA=
